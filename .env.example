# redswitchboard + stock TeslaMate v4 stack -- environment.
#
# Copy to .env (same directory you run compose from), fill in the secrets, and
# never commit .env. examples/rivian-to-teslamate/compose.yaml reads these via ${VAR} + env_file.
#
#   cp .env.example .env
#   $EDITOR .env
#
# ---------------------------------------------------------------------------
# TeslaMate core secrets (required)
# ---------------------------------------------------------------------------

# Key used by TeslaMate to encrypt the stored API tokens. REQUIRED.
# Generate one, e.g.:  openssl rand -base64 32
ENCRYPTION_KEY=please-change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Postgres / database (shared by teslamate + database + grafana)
# ---------------------------------------------------------------------------
TM_DB_USER=teslamate
TM_DB_PASS=please-change-me-to-a-secure-db-password
TM_DB_NAME=teslamate
# Service name of the Postgres container on the compose network. Leave as-is.
TM_DB_HOST=database

# ---------------------------------------------------------------------------
# Tesla Fleet API provider block -> points stock TeslaMate at redswitchboard.
# Mirrors the MyTeslaMate/Teslemetry block in TeslaMate's api.md docs, but the
# host is our in-network proxy. Do NOT change the hosts unless you also change
# the redswitchboard service name/port.
# ---------------------------------------------------------------------------
TESLA_API_HOST=http://redswitchboard:4000
TESLA_AUTH_HOST=http://redswitchboard:4000
TESLA_AUTH_PATH=/api/oauth2/v3

# TeslaMate appends this verbatim to every API request, so it MUST keep the
# literal "?token=" prefix. The part after "?token=" must equal
# REDSWITCHBOARD_TOKEN below (and sinks.tesla.provider_token in config/redswitchboard.yaml).
TOKEN=?token=local

# ---------------------------------------------------------------------------
# redswitchboard provider proxy
# ---------------------------------------------------------------------------
# Shared secret the proxy checks against the incoming ?token=. Must match the
# value after "?token=" in TOKEN above. For local use the default is fine.
REDSWITCHBOARD_TOKEN=local

# ---------------------------------------------------------------------------
# Grafana (dashboards, published on host :3000)
# ---------------------------------------------------------------------------
# Initial admin login. Default user is "admin"; change the password.
GRAFANA_USER=admin
GRAFANA_PASS=admin
